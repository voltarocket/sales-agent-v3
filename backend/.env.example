PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://sales:sales_pass@localhost:5432/sales_agent

# Unique ID for this device/installation (auto-generated from hostname if empty)
DEVICE_ID=

# Website URL — admin login and license activation happen via the website account
# Production: point to your VPS, e.g. https://yourdomain.com
WEBSITE_URL=http://localhost:3003

# Global backend (AI gateway)
# Production: point to your VPS, e.g. http://185.x.x.x:3002 or https://api.yourdomain.com
GLOBAL_BACKEND_URL=http://localhost:3002
# Must match ADMIN_SECRET in global-backend/.env
GLOBAL_ADMIN_SECRET=change-me-in-production

# FreePBX / SIP
FREEPBX_HOST=localhost
FREEPBX_WS_PORT=8088
FREEPBX_DOMAIN=
FREEPBX_EXTENSION=1000
FREEPBX_PASSWORD=
FREEPBX_EXT_2=
FREEPBX_PASS_2=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: explicit ffmpeg path
# FFMPEG_PATH=/usr/bin/ffmpeg
