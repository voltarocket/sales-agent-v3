PORT=3003
DATABASE_URL=postgresql://sales:sales_pass@localhost:5432/sales_agent
# Production: point to your VPS, e.g. http://185.x.x.x:3002 or https://api.yourdomain.com
GLOBAL_BACKEND_URL=http://localhost:3002
# Must match ADMIN_SECRET in global-backend/.env
GLOBAL_ADMIN_SECRET=change-me-in-production
SITE_ADMIN_USER=admin
SITE_ADMIN_PASS=admin
# Download URLs — set to real URLs after building installers
# Build: cd desktop && npm run build  →  desktop/dist/Sales Analyzer Setup.exe
# Build: cd admin   && npm run build  →  admin/dist/Sales Admin Setup.exe
# Build: cd installer && npm run build →  installer/dist/Sales Backend Installer Setup.exe
DOWNLOAD_DESKTOP=https://example.com/downloads/SalesAnalyzer-Setup.exe
DOWNLOAD_ADMIN=https://example.com/downloads/SalesAdmin-Setup.exe
DOWNLOAD_BACKEND=https://example.com/downloads/SalesBackend-Installer.exe
DOWNLOAD_ANDROID=https://example.com/downloads/sales-analyzer.apk
